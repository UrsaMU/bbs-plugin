  "lint": {
    "exclude": ["tests/security/", "tests/security_watcher_cap.test.ts", "tests/permissions.test.ts", "tests/helpers/"]
  },
  "imports": {
    "@ursamu/ursamu":    "jsr:@ursamu/ursamu@^2.3.0",
    "@std/assert":       "jsr:@std/assert@^1.0.0",
    "@std/testing/bdd":  "jsr:@std/testing@^1.0.0/bdd"
  }
}
